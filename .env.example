# Private Marker Web container configuration
PORT=8765
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8765

# Set a private token before exposing this service beyond local loopback.
# The web UI accepts this token on the sign-in screen. API/MCP clients can use it as a Bearer token.
MARKER_WEB_TOKEN=change-this-private-token
MARKER_WEB_SECURE_COOKIE=0

# Container paths
MARKER_WEB_JOB_DIR=/app/data/jobs
MARKER_WEB_FRONTEND_DIST=/app/frontend/dist
MARKER_WEB_MAX_UPLOAD_MB=100
MARKER_WEB_WORKERS=1
# Re-submit queued/running jobs from persistent storage when the service starts.
MARKER_WEB_AUTO_RESUME_JOBS=1

# Image settings used by nerdctl compose.
IMAGE_NAME=localhost/private-marker-web
IMAGE_TAG=latest

# Model/cache paths. Keep these on mounted storage so repeated container starts can reuse downloads.
HF_HOME=/app/data/huggingface
TORCH_HOME=/app/data/torch
XDG_CACHE_HOME=/app/data/cache
